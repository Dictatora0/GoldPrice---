# 数据采集配置
COLLECTION_INTERVAL=30
DATA_SOURCE_TIMEOUT=10
SIGNAL_DEDUP_WINDOW_SECONDS=1800
SINA_SYMBOL=hf_AUTD
EASTMONEY_FS=m:118
EASTMONEY_CODE=AU9999
EASTMONEY_NAME=黄金9999
SGE_SYMBOL=Au99.99

# 分析配置
RSI_PERIOD=14
BOLLINGER_PERIOD=20
BOLLINGER_STD=2
MA_SHORT=7
MA_MEDIUM=30
MA_LONG=90
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# 通知配置
ENABLE_NOTIFICATION=true
NOTIFICATION_COOLDOWN=24

# 数据库配置
DATABASE_PATH=data/gold_price.db
BACKUP_ENABLED=true
BACKUP_TIME=02:00
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Web 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Redis配置
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=__SET_REDIS_PASSWORD_IF_NEEDED__
REDIS_MAX_CONNECTIONS=50

# PostgreSQL配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=goldprice_logs
POSTGRES_USER=goldprice
POSTGRES_PASSWORD=__SET_A_STRONG_PASSWORD__

# 缓存配置
CACHE_PRICE_TTL=120
CACHE_INDICATORS_TTL=120
CACHE_HISTORY_TTL=300
CACHE_CANDLESTICK_TTL=300

# 监控配置
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_COLLECTION_INTERVAL=30

# 告警配置
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_URL=
ALERT_WECHAT_URL=
ALERT_COOLDOWN_MINUTES=30
# 失败后重试次数（总尝试次数 = 1 + 重试次数）
ALERT_WEBHOOK_MAX_RETRIES=1
ALERT_EMAIL_MAX_RETRIES=2
ALERT_WECHAT_MAX_RETRIES=2

# 日志配置
LOG_LEVEL=INFO
LOG_TO_POSTGRES=false
LOG_RETENTION_DAYS=30
